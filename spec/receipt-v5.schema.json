{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askgrokwallet.io/receipt-v5.schema.json",
  "title": "AskGrokWallet receipt, signature version 5",
  "description": "An Ed25519-signed AskGrokWallet receipt. canonical = v5: + JSON.stringify of x-signedFields in the fixed order shown; missing and null values canonicalize to null, and nested object keys are sorted. v5 adds resolution attestation fields for manually reconciling uncertain provider outcomes.",
  "type": "object",
  "x-signedFields": [
    "id", "summary", "amountUsd", "requester", "target", "policyId", "source", "mode", "intentKind",
    "verdict", "reason", "status", "decision", "decidedBy", "execute", "rail", "railRef", "txHash",
    "executionError", "createdAt", "decidedAt", "settledAt", "connector", "actionKind", "action",
    "proposalDigest", "approvedDigest", "expiresAt", "executionState", "idempotencyKey", "providerMessageId",
    "providerThreadId", "providerOutcome", "resolutionOutcome", "resolutionNote", "resolvedAt", "resolvedBy"
  ],
  "required": ["id", "summary", "amountUsd", "requester", "verdict", "status", "createdAt", "signature", "sigAlg", "sigVersion", "signedAt"],
  "properties": {
    "id": { "type": "string" },
    "summary": { "type": "string" },
    "amountUsd": { "type": "number" },
    "requester": { "type": "string" },
    "target": { "type": ["string", "null"] },
    "policyId": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "mode": { "type": ["string", "null"] },
    "intentKind": { "type": ["string", "null"] },
    "verdict": { "type": ["string", "null"], "enum": ["allow", "ask", "deny", null] },
    "reason": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "decision": { "type": ["string", "null"], "enum": ["auto", "approve", "deny", null] },
    "decidedBy": { "type": ["string", "null"] },
    "execute": { "type": ["object", "null"] },
    "rail": { "type": ["string", "null"] },
    "railRef": { "type": ["string", "null"] },
    "txHash": { "type": ["string", "null"] },
    "executionError": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "decidedAt": { "type": ["string", "null"] },
    "settledAt": { "type": ["string", "null"] },
    "connector": { "type": ["string", "null"] },
    "actionKind": { "type": ["string", "null"] },
    "action": { "type": ["object", "null"], "description": "Display-safe exact-action metadata and content hashes." },
    "proposalDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "approvedDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "expiresAt": { "type": ["string", "null"] },
    "executionState": { "type": ["string", "null"] },
    "idempotencyKey": { "type": ["string", "null"] },
    "providerMessageId": { "type": ["string", "null"] },
    "providerThreadId": { "type": ["string", "null"] },
    "providerOutcome": { "type": ["string", "null"] },
    "resolutionOutcome": { "type": ["string", "null"], "enum": ["reconciled", "disputed", null], "description": "Operator attestation — not an independent provider delivery confirmation." },
    "resolutionNote": { "type": ["string", "null"] },
    "resolvedAt": { "type": ["string", "null"] },
    "resolvedBy": { "type": ["string", "null"] },
    "signature": { "type": "string", "contentEncoding": "base64" },
    "sigAlg": { "const": "ED25519" },
    "sigVersion": { "const": 5 },
    "signedAt": { "type": "string" }
  }
}
